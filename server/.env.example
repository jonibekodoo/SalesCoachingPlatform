# Server
PORT=4000
# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret for signing admin sessions (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and files are stored
DATA_DIR=./data
# Optional: Gemini key fallback. The key saved in the admin panel (Sozlamalar) takes precedence.
GEMINI_API_KEY=
# Optional: serve the built admin panel (admin/dist) from this server
NODE_ENV=development
